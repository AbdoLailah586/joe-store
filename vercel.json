{
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/store?cron=jobs",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|product-images/|screen-finder-images/|cover-images/|pwa/|sw\\.js$|manifest\\.webmanifest$|offline\\.html$|robots\\.txt$|sitemap\\.xml$|meta-feed\\.csv$|meta-feed\\.xml$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/og-product?kind=sitemap"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/og-product?kind=sitemap"
    },
    {
      "source": "/meta-feed.csv",
      "destination": "/api/og-product?kind=feed&format=csv"
    },
    {
      "source": "/meta-feed.xml",
      "destination": "/api/og-product?kind=feed&format=xml"
    },
    {
      "source": "/api/meta-feed",
      "destination": "/api/og-product?kind=feed"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://connect.facebook.net https://*.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; img-src 'self' data: blob: https: http:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://*.google-analytics.com https://*.googletagmanager.com https://analytics.google.com https://www.facebook.com https://connect.facebook.net https://nominatim.openstreetmap.org https://*.tile.openstreetmap.org https://checkout.kashier.io https://accept.paymob.com; frame-src 'self' https://accounts.google.com https://checkout.kashier.io https://accept.paymob.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/|product-images/|screen-finder-images/|cover-images/|pwa/|sw\\.js$|manifest\\.webmanifest$|offline\\.html$|robots\\.txt$|sitemap\\.xml$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/product-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
