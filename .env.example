# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://username:password@ep-xyz-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
VITE_DATABASE_URL="postgresql://username:password@ep-xyz-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# --- Option 1: Gmail SMTP (Recommended - Free 500 emails/day to ANY email address, no domain required) ---
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_FROM="JOE Store <your-email@gmail.com>"

# --- Option 2: Brevo API (Free 300 emails/day to ANY email address, no domain DNS required) ---
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx"
# BREVO_SENDER_EMAIL="your-email@gmail.com"
# BREVO_SENDER_NAME="JOE Store"

# --- Option 3: Resend API (Requires custom domain verification at resend.com/domains) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
