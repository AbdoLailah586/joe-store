# Neon PostgreSQL (Use the `-pooler` connection string in eu-central-1 matching Vercel fra1)
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
VITE_DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Google Sign-In
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Transactional Email (Resend preferred; Gmail SMTP or Brevo supported as fallback)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
BREVO_API_KEY=

# Scheduled Jobs & Automated 2-Hour Neon -> Google Drive Backups
CRON_SECRET=replace-with-strong-32byte-random-hex
NEON_API_KEY=napi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEON_PROJECT_ID=your-neon-project-id
GOOGLE_DRIVE_BACKUP_FOLDER=your-google-drive-folder-id
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional: Redis Distributed Rate Limiting (falls back to Neon security_rate_limits when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Meta Conversions API (Server-side purchase events)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# WhatsApp Pro CRM Server Notifications (keep server-side only; never commit secrets)
WHATSAPP_CRM_URL=
WHATSAPP_CRM_EMAIL=
WHATSAPP_CRM_PASS=
WHATSAPP_ADMIN_RECIPIENTS=
